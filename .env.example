# Copy to .env. Generate a key using: npm run admin-key
HOST=127.0.0.1
PORT=3000
WAGZ_ADMIN_KEY=
WAGZ_DATABASE_PATH=data/wagz.sqlite
# Source-backed imports publish when required fields are present.
WAGZ_AUTO_PUBLISH=true
WAGZ_FETCH_INTERVAL_MINUTES=360
WAGZ_FETCH_ON_START=true
# Add the key locally; never commit or paste it into chat.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
WAGZ_AI_MONTHLY_BUDGET_USD=1
WAGZ_AI_SEARCH_ENABLED=true
# Also set a $1 monthly limit on the dedicated OpenRouter key.
