# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
**/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Env / secrets
.env
.env.local
.env*.local

# Supabase local
supabase/.branches/
supabase/.temp/

# Tooling scratch
.appium-screenshots/
design/preview/.cache/

# ── Pub workspace ────────────────────────────────────────────────────────────
# One lockfile at the root; member packages must not carry their own.
/packages/*/pubspec.lock
/apps/*/pubspec.lock
/services/*/pubspec.lock
/tools/*/pubspec.lock
**/.dart_tool/
*.iml

# Coverage output
coverage/

# ── Strays the Flutter tool writes to the repo root ──────────────────────────
# Running a Flutter command from the workspace root instead of from
# `apps/mobile` makes the tool treat the root as the app and emit an
# `android/` tree here. It is generated, it is machine-specific
# (`local.properties` holds absolute SDK paths), and the real Android project
# lives at `apps/mobile/android`. Ignored rather than deleted-and-forgotten,
# because the mistake is one keystroke away and the folder is easy to commit
# without noticing.
/android/
/ios/
/linux/
/macos/
/windows/
/web/

# flutter_test's golden-mismatch dump. Written next to the test on any
# `matchesGoldenFile` failure (masked/isolated diffs, both images); useful on
# the machine that failed, meaningless anywhere else.
/apps/mobile/test/failures/

# Downloaded OSM extracts, cached by tools/cartography/add_city.py. Megabytes
# of upstream data that the generated .sql and .ekmap already carry forward —
# checking it in would put the input and the output of the same pipeline in
# the repository, and only one of them is reviewable.
/.cache/
