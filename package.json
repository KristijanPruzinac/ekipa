{
  "name": "wagz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && vite build --ssr server/public-pages.ts --outDir .wagz-server",
    "start": "tsx server/index.ts --production",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test --test-concurrency=1 server/*.test.ts server/ingestion/*.test.ts server/ai/*.test.ts",
    "collect": "tsx server/collect.ts",
    "admin-key": "tsx scripts/admin-key.ts",
    "test:browser": "node scripts/smoke.mjs",
    "test:discovery": "node scripts/discovery-smoke.mjs",
    "test:review": "node --import tsx scripts/review-smoke.mjs",
    "test:seo": "node --import tsx scripts/seo-smoke.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
